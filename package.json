{
  "name": "snake-knot-card",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "host:create": "node --import tsx scripts/create-host.ts",
    "presets:seed": "node --import tsx scripts/seed-presets.ts",
    "art:optimize": "node --import tsx scripts/optimize-art.ts",
    "check": "tsc --noEmit",
    "art:check": "node --import tsx scripts/check-art.ts",
    "test:production": "node --import tsx tests/production-smoke.ts",
    "verify": "npm run check && npm test && npm run art:check && npm run build && npm run test:e2e && npm run test:production"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "express": "^5.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.70.0",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "license": "UNLICENSED"
}
